# HealthMate environment variables (template)
# Copy to .env and fill in values for local development:
#   cp .env.sample .env

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Vercel PostgreSQL or local Postgres)
DATABASE_URL="postgresql://localhost:5432/healthmate?sslmode=disable"

# Vercel Blob storage (profile pictures, file uploads)
# BLOB_READ_WRITE_TOKEN=

# Auth.js (credentials auth — initial release)
# AUTH_SECRET=           # Generate: openssl rand -base64 32
# AUTH_URL=http://localhost:3000

# External integrations (when configured)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMS_API_KEY=
