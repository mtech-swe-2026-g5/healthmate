# HealthMate environment variables (template)
# Copy to .env and fill in values for local development:
#   cp .env.sample .env

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (when configured)
# DATABASE_URL=

# Auth (when configured)
# AUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Email / SMS reminders (when configured)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMS_API_KEY=
