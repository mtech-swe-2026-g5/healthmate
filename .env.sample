# HealthMate environment variables (template)
# Copy to .env and fill in values for local development:
#   cp .env.sample .env

# App
# Base URL for links in outbound email. On Vercel this is auto-detected from
# VERCEL_PROJECT_PRODUCTION_URL, so only set it for a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Clinic wall-clock timezone for appointment slots (must match seed/doctor slots)
NEXT_PUBLIC_CLINIC_TIMEZONE=Asia/Kolkata
# How close to the start time a patient may still cancel or reschedule online.
# Defaults to 24 when unset or unparseable; 0 disables the window entirely.
APPOINTMENT_CANCELLATION_CUTOFF_HOURS=24

# Database (Vercel PostgreSQL or local Postgres)
# Local: sslmode=disable. Hosted (e.g. Prisma Postgres): use sslmode=verify-full
# (not require — that triggers a pg deprecation warning).
DATABASE_URL="postgresql://postgresql@localhost:5432/healthmate?sslmode=disable"

# Vercel Blob storage (profile pictures, file uploads)
# BLOB_READ_WRITE_TOKEN=

# Auth.js (credentials auth — initial release) — REQUIRED
AUTH_SECRET=             # Generate: openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Session/JWT lifetimes in seconds (optional — sensible defaults applied).
# "remember me" on uses the long value, off uses the short value.
# AUTH_SESSION_MAX_AGE_SECONDS=604800        # 7 days (default)
# AUTH_SESSION_MAX_AGE_SHORT_SECONDS=1800    # 30 minutes (default)

# Email notifications (booking confirmations, registration welcome)
# Any SMTP provider works — Brevo, SendGrid, Gmail app password, or a sandbox.
# Leave SMTP_HOST empty to disable delivery: bookings and sign-ups still
# succeed, and each skipped notification is logged.
# Verify settings without booking: pnpm email:test you@example.com
SMTP_HOST=
SMTP_PORT=587
# true forces implicit TLS; port 465 enables it automatically
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender address; falls back to SMTP_USER when unset
EMAIL_FROM=
EMAIL_FROM_NAME=HealthMate
# Set to false to switch off all outbound email in an environment
EMAIL_NOTIFICATIONS_ENABLED=true

# External integrations (when configured)
# SMS_API_KEY=

# Razorpay (appointment booking payment) — REQUIRED on Vercel for /appointments/book
# Use Test keys from https://dashboard.razorpay.com for local development.
# Missing keys return HTTP 503 (not a silent 500).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=
# Fixed consultation fee in INR (server converts to paise)
CONSULTATION_FEE_INR=500
