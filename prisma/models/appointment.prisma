// Appointments, payments, and scheduling models (patient HAS7 + doctor dashboard)

enum AppointmentStatus {
  CONFIRMED
  CANCELLED

  @@map("appointment_status")
}

// Transitions worth auditing. Creation is already recorded by
// `appointments.created_at`, so only post-booking changes are logged here.
enum AppointmentHistoryEvent {
  RESCHEDULED
  CANCELLED

  @@map("appointment_history_event")
}

enum AppointmentNotificationType {
  ACTION_BOOKED
  ACTION_CANCELLED
  ACTION_RESCHEDULED
  REMINDER_8AM
  REMINDER_60MIN
  REMINDER_30MIN

  @@map("appointment_notification_type")
}

enum AppointmentNotificationStatus {
  PENDING
  SUCCESS
  FAILED

  @@map("appointment_notification_status")
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED

  @@map("payment_status")
}

// ============================================
// Clinic working hours (global defaults for patient booking MVP)
// dayOfWeek: 0 = Sunday … 6 = Saturday
// ============================================

model WorkingHours {
  id                  Int     @id @default(autoincrement()) @db.SmallInt
  dayOfWeek           Int     @unique @map("day_of_week") @db.SmallInt
  startTime           String  @map("start_time") @db.VarChar(5)
  endTime             String  @map("end_time") @db.VarChar(5)
  slotDurationMinutes Int     @default(60) @map("slot_duration_minutes") @db.SmallInt
  isActive            Boolean @default(true) @map("is_active")

  @@map("working_hours")
}

// ============================================
// Appointments (HAS7 patient booking + doctor dashboard)
// ============================================

model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  bookingReference String            @unique @map("booking_reference") @db.VarChar(20)
  patientId        String            @map("patient_id") @db.Uuid
  doctorId         String            @map("doctor_id") @db.Uuid
  startsAt         DateTime          @map("starts_at") @db.Timestamptz()
  endsAt           DateTime          @map("ends_at") @db.Timestamptz()
  status           AppointmentStatus @default(CONFIRMED)
  reasonForVisit   String            @default("General consultation") @map("reason_for_visit") @db.VarChar(200)
  additionalNotes  String?           @map("additional_notes") @db.VarChar(500)
  cancelledAt      DateTime?         @map("cancelled_at") @db.Timestamptz()
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  patient Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor               @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  payment Payment?
  history AppointmentHistory[]
  notifications AppointmentNotificationLog[]

  // Double-booking is prevented by the PARTIAL unique index
  // `appointments_doctor_id_starts_at_confirmed_key` (`WHERE status = 'CONFIRMED'`),
  // created in 20260815000000_add_appointment_cancellation_rescheduling. Prisma
  // cannot express a filtered index, so it is not declared here — a plain
  // `@@unique` would block reusing a slot freed by a cancellation, because
  // cancelled rows are retained for audit.
  @@index([patientId, startsAt])
  @@index([doctorId, startsAt])
  @@index([status])
  @@map("appointments")
}

// ============================================
// Appointment audit trail (cancellation + rescheduling)
// One row per state transition; rows are never updated or deleted.
// ============================================

model AppointmentHistory {
  id               String                  @id @default(uuid()) @db.Uuid
  appointmentId    String                  @map("appointment_id") @db.Uuid
  event            AppointmentHistoryEvent
  previousStartsAt DateTime                @map("previous_starts_at") @db.Timestamptz()
  previousEndsAt   DateTime                @map("previous_ends_at") @db.Timestamptz()
  // Null for a cancellation — the appointment keeps its slot, it just frees up.
  newStartsAt      DateTime?               @map("new_starts_at") @db.Timestamptz()
  newEndsAt        DateTime?               @map("new_ends_at") @db.Timestamptz()
  changedByUserId  String                  @map("changed_by_user_id") @db.Uuid
  changedByRole    String                  @map("changed_by_role") @db.VarChar(20)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz()

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_history")
}

model AppointmentNotificationLog {
  id               String                        @id @default(uuid()) @db.Uuid
  appointmentId    String                        @map("appointment_id") @db.Uuid
  recipientUserId  String                        @map("recipient_user_id") @db.Uuid
  notificationType AppointmentNotificationType   @map("notification_type")
  dedupeKey        String                        @map("dedupe_key") @db.VarChar(120)
  status           AppointmentNotificationStatus @default(PENDING)
  errorMessage     String?                       @map("error_message") @db.VarChar(500)
  sentAt           DateTime?                     @map("sent_at") @db.Timestamptz()
  createdAt        DateTime                      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime                      @updatedAt @map("updated_at") @db.Timestamptz()

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recipient   User        @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, recipientUserId, notificationType, dedupeKey], name: "appointment_notification_once")
  @@index([notificationType, status, createdAt])
  @@index([recipientUserId, createdAt])
  @@map("appointment_notification_logs")
}

// ============================================
// Payments (Razorpay) — booking draft until CAPTURED
// ============================================

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  patientId         String        @map("patient_id") @db.Uuid
  razorpayOrderId   String        @unique @map("razorpay_order_id") @db.VarChar(64)
  razorpayPaymentId String?       @unique @map("razorpay_payment_id") @db.VarChar(64)
  amountInPaise     Int           @map("amount_in_paise")
  currency          String        @default("INR") @db.VarChar(3)
  status            PaymentStatus @default(CREATED)
  doctorId          String        @map("doctor_id") @db.Uuid
  appointmentDate   String        @map("appointment_date") @db.VarChar(10)
  startTime         String        @map("start_time") @db.VarChar(5)
  reasonForVisit    String        @map("reason_for_visit") @db.VarChar(200)
  additionalNotes   String?       @map("additional_notes") @db.VarChar(500)
  appointmentId     String?       @unique @map("appointment_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([status])
  @@map("payments")
}

enum ScheduleBlockType {
  TIME_OFF
  BREAK

  @@map("schedule_block_type")
}

// ============================================
// Doctor schedule blocks (time off, breaks, holidays)
// ============================================

model ScheduleBlock {
  id        String            @id @default(uuid()) @db.Uuid
  doctorId  String            @map("doctor_id") @db.Uuid
  startsAt  DateTime          @map("starts_at") @db.Timestamptz()
  endsAt    DateTime          @map("ends_at") @db.Timestamptz()
  reason    String?           @db.VarChar(120)
  blockType ScheduleBlockType @default(TIME_OFF) @map("block_type")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt, endsAt])
  @@map("schedule_blocks")
}

// ============================================
// Per-doctor slot configurations (doctor dashboard)
// ============================================

model SlotConfiguration {
  id         String    @id @default(uuid()) @db.Uuid
  doctorId   String?   @map("doctor_id") @db.Uuid
  // Captures the recurring day structure (e.g., 1 = Monday, 6 = Saturday)
  dayOfWeek  Int       @map("day_of_week")
  startTime  DateTime  @map("start_time") @db.Time(0)
  endTime    DateTime  @map("end_time") @db.Time(0)
  // Optional label for breaks or named sessions shown on the doctor calendar
  label      String?   @db.VarChar(80)
  // IANA timezone identifier (e.g. "Asia/Kolkata") that startTime/endTime are
  // wall-clock times in. Required for accurate timezone conversion.
  timezone   String    @default("Asia/Kolkata") @map("timezone")
  validFrom  DateTime  @map("valid_from") @db.Timestamptz()
  validUntil DateTime? @map("valid_until") @db.Timestamptz()
  active     Boolean   @default(true) @map("active")
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  doctor     Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, validFrom, validUntil, active], name: "idx_slot_config_lookup")
  @@map("slot_configurations")
}
