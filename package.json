{
  "name": "healthmate",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postbuild": "if [ \"$VERCEL\" = '1' ]; then prisma migrate deploy; fi",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "email:test": "tsx scripts/send-test-email.ts",
    "postinstall": "prisma generate",
    "db:check": "prisma validate && prisma format --check",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "prepare": "husky"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "^9.0.3",
    "razorpay": "^2.9.8",
    "react": "19.2.6",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.82.0",
    "react-icons": "^5.7.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.2.2+sha224.501681044e3f471e4d3d2c50d6a231e2e3822a7f"
}
